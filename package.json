{
  "name": "@brooswit/drovr",
  "version": "0.16.14",
  "description": "Provider-neutral managed-agent runtime and correction layer over the Herdr SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooswit-factory/drovr.git"
  },
  "homepage": "https://github.com/brooswit-factory/drovr#readme",
  "bugs": {
    "url": "https://github.com/brooswit-factory/drovr/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --sourcemap=external && bun x --no-install tsc -p tsconfig.build.json",
    "typecheck": "bun x --no-install tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepack": "bun run check",
    "check": "bun run typecheck && bun test && bun run build",
    "verify:canonical-gate-live": "bun run scripts/verify-canonical-gate-live.ts"
  },
  "dependencies": {
    "@brooswit/herdr-sdk": "0.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5",
    "fast-uri": "3.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "overrides": {
    "zod": "4.6.5",
    "fast-uri": "3.1.8",
    "@brooswit/herdr-sdk": "0.3.0"
  }
}
