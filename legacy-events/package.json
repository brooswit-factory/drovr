{
  "name": "@brooswit/drovr-events",
  "version": "0.12.0-rc.3",
  "description": "Provider-neutral managed-agent runtime and correction layer over the Herdr SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brooswit-factory/drovr.git"
  },
  "homepage": "https://github.com/brooswit-factory/drovr#readme",
  "bugs": {
    "url": "https://github.com/brooswit-factory/drovr/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts src/freeze-cli.ts --outdir dist --target bun --sourcemap=external"
  },
  "dependencies": {
    "@brooswit/herdr-sdk": "0.1.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5",
    "fast-uri": "3.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "bin": {
    "drovr-instance": "./dist/freeze-cli.js"
  },
  "overrides": {
    "zod": "4.6.5",
    "fast-uri": "3.1.8"
  }
}
